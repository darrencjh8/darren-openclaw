{
    "skills": {
        "load": {
            "extraDirs": [
                "/home/node/skills",
                "/home/node/.openclaw/workspace/skills"
            ]
        }
    },
    "plugins": {
        "entries": {
            "expense-tracker-tools": { "enabled": true }
        }
    },
    "models": {
        "providers": {
            "deepseek": {
                "apiKey": "${DEEPSEEK_API_KEY}",
                "baseUrl": "https://api.deepseek.com",
                "models": [
                    {
                        "id": "deepseek-v4-flash",
                        "name": "DeepSeek V4 Flash"
                    },
                    {
                        "id": "deepseek-v4-pro",
                        "name": "DeepSeek V4 Pro"
                    }
                ]
            },
            "google": {
                "apiKey": "${GEMINI_API_KEY}",
                "models": [
                    {
                        "id": "gemini-3.5-flash",
                        "name": "Gemini 3.5 Flash"
                    },
                    {
                        "id": "gemini-3.1-flash-lite",
                        "name": "Gemini 3.1 Flash Lite"
                    }
                ]
            }
        }
    },
    "browser": {
        "noSandbox": true,
        "cdpUrl": "${CDP_URL}",
        "attachOnly": true
    },
    "agents": {
        "defaults": {
            "workspace": "/app/.openclaw/workspace",
            "sandbox": {
                "mode": "off",
                "browser": {
                    "enabled": true
                }
            },
            "models": {
                "deepseek/deepseek-v4-flash": {
                    "params": {
                        "context1m": true,
                        "maxTokens": 384000
                    }
                },
                "deepseek/deepseek-v4-pro": {
                    "params": {
                        "context1m": true,
                        "maxTokens": 384000
                    }
                },
                "google/gemini-3.5-flash": {
                    "params": {
                        "context1m": true,
                        "maxTokens": 65536
                    }
                },
                "google/gemini-3.1-flash-lite": {
                    "params": {
                        "context1m": true,
                        "maxTokens": 65536
                    }
                }
            },
            "memorySearch": {
                "provider": "gemini"
            },
            "compaction": {
                "reserveTokens": 40000,
                "reserveTokensFloor": 20000,
                "memoryFlush": {
                    "enabled": true,
                    "softThresholdTokens": 4000
                }
            },
            "mediaGenerationAutoProviderFallback": false
        },
        "list": [
            {
                "id": "orchestrator",
                "thinkingDefault": "medium",
                "model": {
                    "primary": "deepseek/deepseek-v4-flash",
                    "fallbacks": [
                        "google/gemini-3.5-flash",
                        "google/gemini-3.1-flash-lite"
                    ]
                },
                "contextTokens": 128000,
                "subagents": {
                    "allowAgents": ["thinker"],
                    "delegationMode": "prefer"
                }
            },
            {
                "id": "thinker",
                "workspace": "/app/.openclaw/workspace-thinker",
                "thinkingDefault": "xhigh",
                "model": {
                    "primary": "deepseek/deepseek-v4-pro",
                    "fallbacks": ["deepseek/deepseek-v4-flash"]
                }
            }
        ]
    },
    "bindings": [
        {
            "agentId": "orchestrator",
            "match": {
                "channel": "telegram",
                "accountId": "*"
            }
        }
    ],
    "gateway": {
        "port": 18789,
        "bind": "lan",
        "mode": "local",
        "auth": {
            "token": "${OPENCLAW_GATEWAY_TOKEN}"
        }
    },
    "diagnostics": {
        "stuckSessionAbortMs": 120000
    },
    "tools": {
        "exec": {
            "mode": "auto",
            "timeoutSec": 30,
            "strictInlineEval": true
        },
        "deny": ["image_generate"]
    },
    "messages": {
        "tts": {
            "auto": "tagged",
            "provider": "microsoft",
            "providers": {
                "microsoft": {
                    "speakerVoice": "en-US-AnaNeural",
                    "lang": "en-US"
                }
            }
        }
    },
    "channels": {
        "telegram": {
            "enabled": true,
            "botToken": "${TELEGRAM_BOT_TOKEN}",
            "dmPolicy": "allowlist",
            "allowFrom": ["tg:${TELEGRAM_CHAT_ID}"]
        }
    },
    "hooks": {
        "enabled": true,
        "token": "7e97ba7091f76f0191ff3e48308f5244d1a4a071e14413089ac1cd80f77aae42",
        "path": "/api",
        "allowRequestSessionKey": false,
        "mappings": [
            {
                "match": {
                    "path": "notify"
                },
                "action": "agent",
                "agentId": "orchestrator",
                "wakeMode": "now",
                "messageTemplate": "{{message}}",
                "deliver": true
            }
        ]
    }
}
