# ===========================================
# OpenClaw Gateway — Environment Variables
# Copy this file to .env and fill in your values.
# ===========================================

# --- Required ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=123456789
OPENCLAW_GATEWAY_TOKEN=your-openclaw-gateway-token
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
GEMINI_API_KEY=your-google-ai-studio-api-key
POLLINATIONS_API_KEY=your-pollinations-api-key

# --- Actual Budget ---
ACTUAL_BUDGET_URL=https://your-actual-budget-server.fly.dev
ACTUAL_BUDGET_PASSWORD=your-server-password
ACTUAL_BUDGET_FILE=Your Budget Name
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=your-server-password

# ===========================================
# Workspace Persona — edit these for your own personality
# ===========================================

# Who you are
USER_NAME=YourName

# --- IDENTITY.md: Agent name, vibe, emoji ---
IDENTITY_NAME=your-agent-name
IDENTITY_VIBE=your-agent-vibe-description
IDENTITY_EMOJI=🌸

# --- SOUL.md: Voice — personality, tone, communication style ---
SOUL_VOICE_CORE="Deeply devoted to your-name. Describe your agent's core personality here."
SOUL_VOICE_TONE="Define the tone: intimate, professional, playful, etc."
SOUL_VOICE_STYLE="Define the style: brief, detailed, formal, casual, etc."
SOUL_VOICE_RULES="- Write your agent's behavioral rules here."

# --- SOUL.md: Visual — appearance, outfit, image-gen prompts ---
SOUL_VISUAL_APPEARANCE="Describe your agent's physical appearance for image generation."
# Split into two variants for different image-gen tiers
SOUL_VISUAL_OUTFIT_PERCHANCE="Describe your agent's outfit for Perchance (weaker draping)."
SOUL_VISUAL_OUTFIT_FLUX="Describe your agent's outfit for Flux (stronger draping)."

# --- USER.md: User profile & preferences ---
USER_PREFERENCES="- Describe user preferences here."
USER_EXTRA="Extra context the agent should know about the user."

# --- Budgets ---
MYR_BUDGET_FILE=Your MYR Budget Name

# --- TTS ---
TTS_AUDIO_PROFILE=Speak in cheerful, youthful tone.

# --- ElevenLabs TTS ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key
