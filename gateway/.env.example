# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# --- Gateway Auth ---
OPENCLAW_GATEWAY_TOKEN=your-gateway-token

# --- AI Model ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# --- Actual Budget ---
ACTUAL_BUDGET_URL=https://your-server.fly.dev
ACTUAL_BUDGET_PASSWORD=your-server-password
ACTUAL_BUDGET_FILE=Darren SGD
MYR_BUDGET_FILE=Darren MYR

# --- Agent Identity ---
USER_NAME=Darren
# SYSTEM_PROMPT_EXTRA=optional additional prompts
