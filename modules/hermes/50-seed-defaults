# shellcheck shell=sh
# shellcheck disable=SC2015,SC2235
# Seed baked-in config, SOUL, skills, and scripts on every boot.
# Then resolve any remaining ${VAR} placeholders that Hermes doesn't auto-substitute.
cp /opt/hermes-defaults/config.yaml /opt/data/config.yaml
[ ! -f /opt/data/SOUL.md ] && cp /opt/hermes-defaults/SOUL.md.template /opt/data/SOUL.md
mkdir -p /opt/data/skills
cp -r /opt/hermes-defaults/skills/* /opt/data/skills/
chown -R hermes:hermes /opt/data/skills 2>/dev/null || true
# codex-router owns the skills it publishes (dev-loop, code-reviewer, ...). The
# deploy stages its canonical tree at /opt/data/.codex-router-skills and this
# reconciliation replaces whatever copy an older seed or hand-install left in
# any runtime skill root. A no-op until a deploy has staged a source.
/opt/hermes-defaults/scripts/sync-codex-router-skills.sh 2>/dev/null || true
mkdir -p /opt/data/scripts
cp -r /opt/hermes-defaults/scripts/* /opt/data/scripts/
chmod +x /opt/data/scripts/*.sh

# Tier-2 topic files: durable facts that do not fit the always-on memory core.
# The agent reads them with the file tools, and the memory-triage judge appends to
# them instead of holding a record that cannot fit. Seeded once; never overwritten.
mkdir -p /opt/data/memories/topics
if [ ! -f /opt/data/memories/topics/INDEX.md ]; then
    cat > /opt/data/memories/topics/INDEX.md <<'TOPICINDEX'
# Topic memory index

Durable facts that do not fit `MEMORY.md` live here, one file per domain. The agent
searches this directory before answering a recall question, and the memory-triage
judge appends here when a fact cannot fit the always-on core.

Every line carries its aliases so keyword search finds it, for example:

    Groceries / supermarket / NTUC FairPrice / Cold Storage -> payee Groceries

Files:
- infra.md — hosts, containers, ports, deploy paths
- accounts.md — accounts, cards, identifiers
- expenses.md — payee and category mappings
- prefs.md — stable preferences and corrections
TOPICINDEX
fi
if [ ! -f /opt/data/memories/topics/MISSES.md ]; then
    printf '%s\n' \
        '# Recall misses' \
        '' \
        'One line per miss: date, the question asked, what could not be found, and whether' \
        'an alias on the label would have fixed it. A month of misses decides whether a' \
        'semantic index is worth adding.' \
        > /opt/data/memories/topics/MISSES.md
fi
chown -R hermes:hermes /opt/data/memories/topics 2>/dev/null || true

# Seed opencode CLI config into BOTH runtime homes on every boot. opencode reads
# $HOME/.config/opencode/opencode.json, and HOME differs between the Hermes
# daemon (/opt/data) and interactive terminal sessions (/opt/data/home). Merge,
# don't clobber: canonical provider/models and the default model win (fixes
# drift), while keys installed at runtime (instructions, plugin, agent) survive.
python3 - /opt/hermes-defaults/opencode/opencode.json \
    /opt/data/.config/opencode/opencode.json \
    /opt/data/home/.config/opencode/opencode.json <<'PYOPENCODE'
import json
import sys
from pathlib import Path

canonical = json.loads(Path(sys.argv[1]).read_text())

for target in (Path(p) for p in sys.argv[2:]):
    target.parent.mkdir(parents=True, exist_ok=True)
    merged = {}
    if target.exists():
        try:
            merged = json.loads(target.read_text())
        except ValueError:
            merged = {}
    for key, value in canonical.items():
        if key in ("provider", "model"):
            merged[key] = value
        else:
            merged.setdefault(key, value)
    target.write_text(json.dumps(merged, indent=2) + "\n")
PYOPENCODE
chown hermes:hermes \
    /opt/data/.config/opencode/opencode.json \
    /opt/data/home/.config/opencode/opencode.json 2>/dev/null || true

# Remove retired profile runtime state before seeding the managed profile set.
for retired_profile in static-analyst qa-engineer quality-assurance; do
    rm -rf "/opt/data/profiles/$retired_profile"
done

# Seed profile configs and SOUL files (idempotent — won't overwrite existing)
for profile_dir in /opt/hermes-defaults/profiles/*/; do
    [ -d "$profile_dir" ] || continue
    name=$(basename "$profile_dir")
    mkdir -p "/opt/data/profiles/$name"
    # Only seed if file doesn't already exist (preserves user edits)
    [ ! -f "/opt/data/profiles/$name/config.yaml" ] && cp "$profile_dir/config.yaml" "/opt/data/profiles/$name/config.yaml" 2>/dev/null || true
    [ ! -f "/opt/data/profiles/$name/SOUL.md" ] && cp "$profile_dir/SOUL.md" "/opt/data/profiles/$name/SOUL.md" 2>/dev/null || true
    [ ! -f "/opt/data/profiles/$name/profile.yaml" ] && cp "$profile_dir/profile.yaml" "/opt/data/profiles/$name/profile.yaml" 2>/dev/null || true

    # Register profile in Hermes (idempotent — fails silently if already exists)
    su -s /bin/sh hermes -c "hermes profile create $name --no-alias 2>/dev/null" || true
done

# Migrate only routing fields for managed profiles while preserving user-owned settings.
python3 - <<'PY'
from pathlib import Path

import yaml

managed_routing_profiles = ("architect", "code-reviewer", "project-manager", "spec-auditor")
for name in managed_routing_profiles:
    default_path = Path(f"/opt/hermes-defaults/profiles/{name}/config.yaml")
    target_path = Path(f"/opt/data/profiles/{name}/config.yaml")
    if not target_path.exists():
        continue
    defaults = yaml.safe_load(default_path.read_text()) or {}
    target = yaml.safe_load(target_path.read_text()) or {}
    for key in ("providers", "model", "fallback_providers"):
        if key in defaults:
            target[key] = defaults[key]
    if name == "code-reviewer":
        memory = target.get("memory")
        if not isinstance(memory, dict):
            memory = {}
            target["memory"] = memory
        memory["memory_enabled"] = False
        memory["user_profile_enabled"] = False
    target_path.write_text(yaml.safe_dump(target, sort_keys=False))
PY

# Ensure cron-run directories are owned by hermes (gateway runs as hermes)
mkdir -p /opt/data/memories-backup
chown -R hermes:hermes /opt/data/memories-backup 2>/dev/null || true

# Configure gh CLI with FRIDAY_PAT (injected via GitHub Actions secret)
# Available at boot time — no racing with dashboard UI
if [ -n "${FRIDAY_PAT:-}" ]; then
    printf '%s' "$FRIDAY_PAT" > /tmp/.gh-token-init
    su -s /bin/sh hermes -c "gh auth login --with-token < /tmp/.gh-token-init" 2>/dev/null || true
    rm -f /tmp/.gh-token-init
fi

python3 -c '
import os, re, glob
paths = ["/opt/data/config.yaml", "/opt/data/SOUL.md"]
# Also resolve env vars in profile configs
paths.extend(glob.glob("/opt/data/profiles/*/config.yaml"))
for path in paths:
    with open(path) as f:
        content = f.read()
    content = re.sub(r"\$\{(\w+)\}", lambda m: os.environ.get(m.group(1), m.group(0)), content)
    with open(path, "w") as f:
        f.write(content)
'

# Seed memory-backup cron job (idempotent — skips if already present)
if [ -n "${MEMORY_REPO_URL}" ]; then
    python3 -c '
import os, json, uuid, datetime
jobs_path = "/opt/data/cron/jobs.json"
os.makedirs(os.path.dirname(jobs_path), exist_ok=True)
try:
    with open(jobs_path) as f:
        data = json.load(f)
    jobs = data.get("jobs", []) if isinstance(data, dict) else data
except (FileNotFoundError, json.JSONDecodeError):
    jobs = []
if not any(j.get("name") == "memory-backup" for j in jobs if isinstance(j, dict)):
    jobs.append({
        "id": uuid.uuid4().hex[:12],
        "name": "memory-backup",
        "schedule": {"kind": "interval", "minutes": 360, "display": "every 360m"},
        "schedule_display": "every 360m",
        "prompt": "Run /opt/data/scripts/memory-backup.sh to sync memories to git",
        "script": "memory-backup.sh",
        "no_agent": True,
        "enabled": True,
        "deliver": "local",
        "next_run_at": None,
        "created_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    })
    with open(jobs_path, "w") as f:
        json.dump({"jobs": jobs, "updated_at": datetime.datetime.now(datetime.timezone.utc).isoformat()}, f, indent=2)
    print("cron: memory-backup seeded")
' || true
fi

# Restore memories from friday-memory repo on first boot
if [ -n "${MEMORY_REPO_URL}" ] && [ ! -f "/opt/data/memories/MEMORY.md" ]; then
    rm -rf /tmp/friday-memory-clone
    git clone "${MEMORY_REPO_URL}" /tmp/friday-memory-clone 2>/dev/null && \
    cp -r /tmp/friday-memory-clone/. /opt/data/memories/ && \
    chown -R hermes:hermes /opt/data/memories/ && \
    rm -rf /tmp/friday-memory-clone || true
fi

# Seed portfolio-sync cron job (no_agent — zero-token REST call)
python3 <<'PYEOF' || true
import os, json, uuid, datetime
jobs_path = "/opt/data/cron/jobs.json"
os.makedirs(os.path.dirname(jobs_path), exist_ok=True)
try:
    with open(jobs_path) as f:
        data = json.load(f)
    jobs = data.get("jobs", []) if isinstance(data, dict) else data
except (FileNotFoundError, json.JSONDecodeError):
    jobs = []

found = False
for j in jobs:
    if not isinstance(j, dict):
        continue
    if j.get("name") == "portfolio-daily-sync":
        found = True
        # Migrate old prompt-based job to no_agent on redeploy
        changed = False
        if not j.get("no_agent"):
            j["no_agent"] = True
            changed = True
        if j.get("script") != "portfolio-sync.sh":
            j["script"] = "portfolio-sync.sh"
            changed = True
        if j.get("deliver") != "local":
            j["deliver"] = "local"
            changed = True
        if "prompt" in j:
            del j["prompt"]
            changed = True
        if "deliver_extra" in j:
            del j["deliver_extra"]
            changed = True
        if changed:
            print("cron: portfolio-daily-sync migrated to no_agent")
        else:
            print("cron: portfolio-daily-sync unchanged")
        break

if not found:
    jobs.append({
        "id": uuid.uuid4().hex[:12],
        "name": "portfolio-daily-sync",
        "schedule": {"kind": "cron", "expr": "0 12 * * *", "display": "0 12 * * *"},
        "schedule_display": "0 12 * * *",
        "script": "portfolio-sync.sh",
        "no_agent": True,
        "enabled": True,
        "deliver": "local",
        "next_run_at": None,
        "created_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    })
    print("cron: portfolio-daily-sync seeded (no_agent)")

with open(jobs_path, "w") as f:
    json.dump({"jobs": jobs, "updated_at": datetime.datetime.now(datetime.timezone.utc).isoformat()}, f, indent=2)
PYEOF

# Seed memory-triage cron job (idempotent — drains the memory write-approval queue).
# The job's scripts and skill are baked into the image (/opt/hermes-defaults), so a
# reinstall re-seeds all three together: cron job, /opt/data/scripts/*, and the
# hermes-troubleshooting skill.
python3 <<'PYEOF' || true
import os, json, uuid, datetime
jobs_path = "/opt/data/cron/jobs.json"
os.makedirs(os.path.dirname(jobs_path), exist_ok=True)
try:
    with open(jobs_path) as f:
        data = json.load(f)
    jobs = data.get("jobs", []) if isinstance(data, dict) else data
except (FileNotFoundError, json.JSONDecodeError):
    jobs = []

PROMPT = """Triage the Hermes memory write-approval queue on this machine (HERMES_HOME=/opt/data).

CONTEXT: memory.write_approval is ON, so every memory write is staged to /opt/data/pending/memory/<id>.json and NOTHING drains it automatically. You are the judge that drains it. A backlog may exist on early runs; each run should only chew the OLDEST 40 records and leave the rest for the next run.

SAFETY: the apply step is reversible by design. It takes a timestamped snapshot of the live memory files before mutating (rollback: bash /opt/data/scripts/memory-triage.sh restore --from <dir>), locks against concurrent runs, strictly validates the plan, caps it at 40 records, and appends an audit line to /opt/data/logs/memory-triage-audit.jsonl. Never bypass the script and never edit the memory files by hand.

STEPS
1. Run: bash /opt/data/scripts/memory-triage.sh list --full > /opt/data/tmp/triage-queue.json
   Always pass --full: without it the script truncates each op to 240 characters and you would judge a partial fact.
2. Read that JSON. It has one entry per staged record with id, target (memory|user), origin, age_days, and the op text.
3. Decide for every record in the oldest 40: approve, discard, or hold.
   - APPROVE — durable fact/preference useful in future sessions: user preferences and corrections, environment facts, account/passenger/infra identifiers, conventions, workflow rules.
   - DISCARD (archived, not applied) — duplicates or paraphrases of a fact already present in /opt/data/memories/MEMORY.md, USER.md, or the topic files, or of another op you just approved; procedures/runbooks (those belong in a skill, not memory); raw task progress, completed-work logs, one-off dated state, anything superseded.
   - HOLD (list in NEITHER array) — ambiguous, contradictory, or unverifiable. Contradictions get held, never resolved by guessing.
4. Dedupe AGGRESSIVELY. When several ops carry the same fact, approve at most ONE consolidated version (clearest, most self-contained wording) and discard the other instances.
5. Respect the store caps: memory 2800 chars and user 1375. If an add would overflow, prefer a replace/remove that frees room and discard lower-value adds. If a fact is durable but still will not fit:
   - append it to the matching topic file under /opt/data/memories/topics/ (create the file if missing; the index lists the domains), one fact per line, aliases on the label so keyword search finds it;
   - then list that record in "discard" as well. Never file a fact and approve it in the same run — two copies of one fact will drift apart.
   Contradictory or unverifiable records are still held, never filed.
6. Write the verdict plan to /opt/data/tmp/triage-plan.json as {"approve": ["<id>", ...], "discard": ["<id>", ...]}
7. Apply it: bash /opt/data/scripts/memory-triage.sh apply --plan /opt/data/tmp/triage-plan.json
   This replays approved ops through apply_memory_pending (bypassing the gate), moves discards into /opt/data/pending/memory-archive/<date>/, and snapshots live memory first. Read the printed report: applied_n, discarded_n, failed, remaining_n, snapshot.
8. Reply with a SHORT digest (Telegram style, no code blocks, no raw JSON, max 5 lines of bullets):
   - counts: applied / discarded / filed / held / still pending
   - the 3-5 most valuable things now saved, one line each
   - any topic file you appended to, by name
   - any FAILED ops with their error, and anything deliberately held with a one-line reason
   If nothing was staged, reply exactly: Memory queue empty — nothing staged.

Do not stop until the apply step has actually run and been verified. If a step fails, say so plainly rather than reporting success."""

# Managed fields are migrated in place, not just appended when the job is missing.
# The job already exists on every long-lived install, so an append-only seed would
# never deliver a prompt change (this is how the topic-file routing rule reaches
# production). User-owned fields are left alone.
MANAGED = {
    "prompt": PROMPT,
    "skills": ["hermes-troubleshooting"],
    "skill": "hermes-troubleshooting",
    "schedule": {"kind": "cron", "expr": "0 9 * * *", "display": "0 9 * * *"},
    "schedule_display": "0 9 * * *",
    "enabled": True,
    "deliver": "telegram",
}

existing = next(
    (j for j in jobs if isinstance(j, dict) and j.get("name") == "memory-triage"),
    None,
)

if existing is None:
    jobs.append({
        "id": uuid.uuid4().hex[:12],
        "name": "memory-triage",
        "context_from": ["self"],
        "next_run_at": None,
        "created_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        **MANAGED,
    })
    print("cron: memory-triage seeded")
else:
    changed = [key for key, value in MANAGED.items() if existing.get(key) != value]
    for key in changed:
        existing[key] = MANAGED[key]
    if changed:
        print("cron: memory-triage migrated: " + ", ".join(sorted(changed)))
    else:
        print("cron: memory-triage unchanged")

with open(jobs_path, "w") as f:
    json.dump({"jobs": jobs, "updated_at": datetime.datetime.now(datetime.timezone.utc).isoformat()}, f, indent=2)
PYEOF

# Disable profile gateways (workers don't need their own gateways — they compete for Telegram token)
for gw_dir in /run/service/gateway-*; do
    [ -d "$gw_dir" ] || continue
    name=$(basename "$gw_dir")
    [ "$name" = "gateway-default" ] && continue
    /package/admin/s6-2.15.0.0/command/s6-svc -D "$gw_dir" 2>/dev/null || true
done

# Initialize kanban board (idempotent — no-op if already exists)
su -s /bin/sh hermes -c "hermes kanban init 2>/dev/null" || true

# Ensure all seeded files are owned by hermes (container runs as hermes)
chown -R hermes:hermes /opt/data 2>/dev/null || true

# Send startup notification to Telegram
if [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_HOME_CHANNEL:-}" ]; then
    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -d chat_id="${TELEGRAM_HOME_CHANNEL}" \
        -d text="🟢 Friday is online and ready." \
        -d disable_notification=true \
        >/dev/null 2>&1 || true
fi
