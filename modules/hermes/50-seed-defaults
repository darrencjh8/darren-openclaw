#!/command/with-contenv sh
# Seed baked-in config, SOUL, skills, and scripts on every boot.
# Then resolve any remaining ${VAR} placeholders that Hermes doesn't auto-substitute.
cp /opt/hermes-defaults/config.yaml /opt/data/config.yaml
cp /opt/hermes-defaults/SOUL.md.template /opt/data/SOUL.md
mkdir -p /opt/data/skills
cp -r /opt/hermes-defaults/skills/* /opt/data/skills/
mkdir -p /opt/data/scripts
cp -r /opt/hermes-defaults/scripts/* /opt/data/scripts/
chmod +x /opt/data/scripts/*.sh

# Ensure cron-run directories are owned by hermes (gateway runs as hermes)
mkdir -p /opt/data/memories-backup
chown -R hermes:hermes /opt/data/memories-backup 2>/dev/null || true

python3 -c '
import os, re
for path in ["/opt/data/config.yaml", "/opt/data/SOUL.md"]:
    with open(path) as f:
        content = f.read()
    content = re.sub(r"\$\{(\w+)\}", lambda m: os.environ.get(m.group(1), m.group(0)), content)
    with open(path, "w") as f:
        f.write(content)

# Inject resolved SOUL.md content into config.yaml {SOUL_MD} placeholder
with open("/opt/data/config.yaml") as f:
    config = f.read()
with open("/opt/data/SOUL.md") as f:
    soul = f.read()
config = config.replace("{SOUL_MD}", soul)
with open("/opt/data/config.yaml", "w") as f:
    f.write(config)
'

# Seed memory-backup cron job (idempotent — skips if already present)
if [ -n "${GITHUB_PAT}" ] && [ -n "${GITHUB_URL}" ]; then
    python3 -c '
import os, json, uuid, datetime
jobs_path = "/opt/data/cron/jobs.json"
os.makedirs(os.path.dirname(jobs_path), exist_ok=True)
try:
    with open(jobs_path) as f:
        data = json.load(f)
    jobs = data.get("jobs", []) if isinstance(data, dict) else data
except (FileNotFoundError, json.JSONDecodeError):
    jobs = []
if not any(j.get("name") == "memory-backup" for j in jobs if isinstance(j, dict)):
    jobs.append({
        "id": uuid.uuid4().hex[:12],
        "name": "memory-backup",
        "schedule": "every 6h",
        "prompt": "Run /opt/data/scripts/memory-backup.sh to sync memories to git",
        "script": "memory-backup.sh",
        "no_agent": True,
        "enabled": True,
        "deliver": "local",
        "next_run_at": None,
        "created_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    })
    with open(jobs_path, "w") as f:
        json.dump({"jobs": jobs, "updated_at": datetime.datetime.now(datetime.timezone.utc).isoformat()}, f, indent=2)
    print("cron: memory-backup seeded")
' || true
fi

