    "enabled": True,
    "next_run_at": None,
}

existing = next(
    (j for j in jobs if isinstance(j, dict) and j.get("name") == "mnemosyne-vacuum"),
    None,
)
if existing is None:
    jobs.append({
        "id": uuid.uuid4().hex[:12],
