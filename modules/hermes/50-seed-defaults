# Configure gh CLI authentication. The helper installs GitHub App auth when the
# App configuration is complete, and otherwise installs the scoped fallback PAT.
# The PAT arrives as a root-only secret file rather than an ambient environment
# variable, so no unrelated child process inherits it; the helper reads that file
# only when the App configuration is incomplete.
# The boot hook is the single reader: it must be a readable, non-empty regular
# file (a directory left by an earlier missing-source mount is not a PAT).
PAT=""
if [ -f /run/secrets/friday_pat ] && [ -s /run/secrets/friday_pat ] && [ -r /run/secrets/friday_pat ]; then
    PAT=$(cat /run/secrets/friday_pat)
fi

# The flat token file is retired: gh owns hosts.yml and the helper feeds the
# credential through stdin only, so clear any stale file before either branch.
rm -f /opt/data/.gh_token 2>/dev/null || true

if [ -n "${GH_APP_ID:-}${GH_APP_INSTALLATION_ID:-}${GH_APP_PRIVATE_KEY:-}" ] || [ -n "$PAT" ]; then
    # `-m` preserves the environment, so the prefix assignment reaches the
    # su'd shell and the helper; nothing needs expanding inside the quotes.
    GH_PAT="$PAT" su -m -s /bin/sh hermes -c '/opt/hermes-defaults/scripts/github-auth.sh' 2>/dev/null \
        || echo "WARNING: GitHub authentication failed at boot" >&2
else
    echo "WARNING: neither GitHub App config nor a fallback PAT secret is present; leaving gh credentials untouched" >&2
fi
unset PAT

