#!/command/with-contenv sh
# shellcheck shell=sh
# shellcheck disable=SC2015,SC2235
# Seed baked-in config, SOUL, skills, and scripts on every boot.
# Then resolve any remaining ${VAR} placeholders that Hermes doesn't auto-substitute.
cp /opt/hermes-defaults/config.yaml /opt/data/config.yaml
[ ! -f /opt/data/SOUL.md ] && cp /opt/hermes-defaults/SOUL.md.template /opt/data/SOUL.md
mkdir -p /opt/data/skills
cp -r /opt/hermes-defaults/skills/* /opt/data/skills/
chown -R hermes:hermes /opt/data/skills 2>/dev/null || true
mkdir -p /opt/data/scripts
cp -r /opt/hermes-defaults/scripts/* /opt/data/scripts/
chmod +x /opt/data/scripts/*.sh

# Remove retired profile runtime state before seeding the managed profile set.
for retired_profile in static-analyst qa-engineer quality-assurance; do
    rm -rf "/opt/data/profiles/$retired_profile"
done

# Seed profile configs and SOUL files (idempotent — won't overwrite existing)
for profile_dir in /opt/hermes-defaults/profiles/*/; do
    [ -d "$profile_dir" ] || continue
    name=$(basename "$profile_dir")
    mkdir -p "/opt/data/profiles/$name"
    # Only seed if file doesn't already exist (preserves user edits)
    [ ! -f "/opt/data/profiles/$name/config.yaml" ] && cp "$profile_dir/config.yaml" "/opt/data/profiles/$name/config.yaml" 2>/dev/null || true
    [ ! -f "/opt/data/profiles/$name/SOUL.md" ] && cp "$profile_dir/SOUL.md" "/opt/data/profiles/$name/SOUL.md" 2>/dev/null || true
    [ ! -f "/opt/data/profiles/$name/profile.yaml" ] && cp "$profile_dir/profile.yaml" "/opt/data/profiles/$name/profile.yaml" 2>/dev/null || true

    # Register profile in Hermes (idempotent — fails silently if already exists)
    su -s /bin/sh hermes -c "hermes profile create $name --no-alias 2>/dev/null" || true
done

# Ensure cron-run directories are owned by hermes (gateway runs as hermes)
mkdir -p /opt/data/memories-backup
chown -R hermes:hermes /opt/data/memories-backup 2>/dev/null || true

# Configure gh CLI with FRIDAY_PAT (injected via GitHub Actions secret)
# Available at boot time — no racing with dashboard UI
if [ -n "${FRIDAY_PAT:-}" ]; then
    printf '%s' "$FRIDAY_PAT" > /tmp/.gh-token-init
    su -s /bin/sh hermes -c "gh auth login --with-token < /tmp/.gh-token-init" 2>/dev/null || true
    rm -f /tmp/.gh-token-init
fi

python3 -c '
import os, re, glob
paths = ["/opt/data/config.yaml", "/opt/data/SOUL.md"]
# Also resolve env vars in profile configs
paths.extend(glob.glob("/opt/data/profiles/*/config.yaml"))
for path in paths:
    with open(path) as f:
        content = f.read()
    content = re.sub(r"\$\{(\w+)\}", lambda m: os.environ.get(m.group(1), m.group(0)), content)
    with open(path, "w") as f:
        f.write(content)
'

# Seed memory-backup cron job (idempotent — skips if already present)
if [ -n "${MEMORY_REPO_URL}" ]; then
    python3 -c '
import os, json, uuid, datetime
jobs_path = "/opt/data/cron/jobs.json"
os.makedirs(os.path.dirname(jobs_path), exist_ok=True)
try:
    with open(jobs_path) as f:
        data = json.load(f)
    jobs = data.get("jobs", []) if isinstance(data, dict) else data
except (FileNotFoundError, json.JSONDecodeError):
    jobs = []
if not any(j.get("name") == "memory-backup" for j in jobs if isinstance(j, dict)):
    jobs.append({
        "id": uuid.uuid4().hex[:12],
        "name": "memory-backup",
        "schedule": {"kind": "interval", "minutes": 360, "display": "every 360m"},
        "schedule_display": "every 360m",
        "prompt": "Run /opt/data/scripts/memory-backup.sh to sync memories to git",
        "script": "memory-backup.sh",
        "no_agent": True,
        "enabled": True,
        "deliver": "local",
        "next_run_at": None,
        "created_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    })
    with open(jobs_path, "w") as f:
        json.dump({"jobs": jobs, "updated_at": datetime.datetime.now(datetime.timezone.utc).isoformat()}, f, indent=2)
    print("cron: memory-backup seeded")
' || true
fi

# Restore memories from friday-memory repo on first boot
if [ -n "${MEMORY_REPO_URL}" ] && [ ! -f "/opt/data/memories/MEMORY.md" ]; then
    rm -rf /tmp/friday-memory-clone
    git clone "${MEMORY_REPO_URL}" /tmp/friday-memory-clone 2>/dev/null && \
    cp -r /tmp/friday-memory-clone/. /opt/data/memories/ && \
    chown -R hermes:hermes /opt/data/memories/ && \
    rm -rf /tmp/friday-memory-clone || true
fi

# Seed portfolio-sync cron job (no_agent — zero-token REST call)
python3 <<'PYEOF' || true
import os, json, uuid, datetime
jobs_path = "/opt/data/cron/jobs.json"
os.makedirs(os.path.dirname(jobs_path), exist_ok=True)
try:
    with open(jobs_path) as f:
        data = json.load(f)
    jobs = data.get("jobs", []) if isinstance(data, dict) else data
except (FileNotFoundError, json.JSONDecodeError):
    jobs = []

found = False
for j in jobs:
    if not isinstance(j, dict):
        continue
    if j.get("name") == "portfolio-daily-sync":
        found = True
        # Migrate old prompt-based job to no_agent on redeploy
        changed = False
        if not j.get("no_agent"):
            j["no_agent"] = True
            changed = True
        if j.get("script") != "portfolio-sync.sh":
            j["script"] = "portfolio-sync.sh"
            changed = True
        if j.get("deliver") != "local":
            j["deliver"] = "local"
            changed = True
        if "prompt" in j:
            del j["prompt"]
            changed = True
        if "deliver_extra" in j:
            del j["deliver_extra"]
            changed = True
        if changed:
            print("cron: portfolio-daily-sync migrated to no_agent")
        else:
            print("cron: portfolio-daily-sync unchanged")
        break

if not found:
    jobs.append({
        "id": uuid.uuid4().hex[:12],
        "name": "portfolio-daily-sync",
        "schedule": {"kind": "cron", "expr": "0 12 * * *", "display": "0 12 * * *"},
        "schedule_display": "0 12 * * *",
        "script": "portfolio-sync.sh",
        "no_agent": True,
        "enabled": True,
        "deliver": "local",
        "next_run_at": None,
        "created_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    })
    print("cron: portfolio-daily-sync seeded (no_agent)")

with open(jobs_path, "w") as f:
    json.dump({"jobs": jobs, "updated_at": datetime.datetime.now(datetime.timezone.utc).isoformat()}, f, indent=2)
PYEOF

# Disable profile gateways (workers don't need their own gateways — they compete for Telegram token)
for gw_dir in /run/service/gateway-*; do
    [ -d "$gw_dir" ] || continue
    name=$(basename "$gw_dir")
    [ "$name" = "gateway-default" ] && continue
    /package/admin/s6-2.15.0.0/command/s6-svc -D "$gw_dir" 2>/dev/null || true
done

# Initialize kanban board (idempotent — no-op if already exists)
su -s /bin/sh hermes -c "hermes kanban init 2>/dev/null" || true

# Ensure all seeded files are owned by hermes (container runs as hermes)
chown -R hermes:hermes /opt/data 2>/dev/null || true

# Send startup notification to Telegram
if [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_HOME_CHANNEL:-}" ]; then
    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -d chat_id="${TELEGRAM_HOME_CHANNEL}" \
        -d text="🟢 Friday is online and ready." \
        -d disable_notification=true \
        >/dev/null 2>&1 || true
fi
