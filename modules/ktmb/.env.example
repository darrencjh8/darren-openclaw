# KTMB account credentials
KTMB_EMAIL=
KTMB_PASSWORD=

# 2captcha API key (for solving reCAPTCHA)
KTMB_CAPTCHA_KEY=

# Tools API server port (default: 8082)
KTMB_API_PORT=8082

# Order management server URL (for worker/daemon, default: localhost:47079)
KTMB_SERVER_URL=http://localhost:47079

# SQLite database path (shared with daemon/worker)
KTMB_DB_PATH=/tmp/ktmb_jobs.db

# IMAP (for password reset emails)
IMAP_HOST=imap.zoho.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Gateway notification webhook (booking success/failure + crash alerts)
KTMB_NOTIFY_URL=http://openclaw:18800/api/notify
