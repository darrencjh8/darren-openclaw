# =============================================================================
# Portfolio Tracker — Environment Configuration
# Copy this file to .env and fill in all values
# =============================================================================

# --- Required ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
ACTUAL_BUDGET_URL=https://flyio-frosty-glitter-5667.fly.dev
ACTUAL_BUDGET_PASSWORD=your-actual-budget-password
ACTUAL_BUDGET_FILE=Darren-SGD-29ed82a
MYR_BUDGET_FILE=Darren-MYR

# --- Telegram (required for Telegram channel) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789

# --- Google Sheets (required for taxonomy export) ---
GOOGLE_SERVICE_ACCOUNT_JSON=/app/config/google-service-account.json
GOOGLE_SHEET_ID=your-google-sheet-id
TAXONOMY_NAMES=Sector,Geography,Asset_Class

# --- Portfolio Performance ---
PP_XML_PATH=/data/portfolio.xml
PP_JAR_PATH=/app/pp-cli.jar

# --- Actual Budget → PP Balance Sync ---
# Names of categories in Actual Budget to query for balance sync
AB_EMERGENCY_SGD_CATEGORY=Emergency_Fund_SGD
AB_EMERGENCY_MYR_CATEGORY=Emergency_Fund_MYR
AB_WARCHEST_CATEGORY=General_Investment_Fund

# UUIDs of PP accounts to update with balances (find via Java CLI: java -jar pp-cli.jar accounts)
PP_EMERGENCY_SGD_ACCOUNT=uuid-of-sgd-emergency-fund-account
PP_EMERGENCY_MYR_ACCOUNT=uuid-of-myr-emergency-fund-account
PP_WARCHEST_SGD_ACCOUNT=uuid-of-sgd-warchest-account

# --- IMAP Email (optional, for email trade confirmations) ---
IMAP_HOST=imap.zoho.com
IMAP_PORT=993
IMAP_USERNAME=your-burner@zoho.com
IMAP_PASSWORD=your-app-specific-password
NOTIFICATION_SMTP_HOST=smtp.zoho.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_EMAIL=your-real-email@gmail.com

# --- Optional ---
LOG_LEVEL=INFO
USER_NAME=Darren
BALANCE_SYNC_CRON=0 9 * * *
TAXONOMY_SYNC_CRON=0 10 * * *
DEDUP_DB_PATH=data/dedup.db
MAPPINGS_PATH=data/mappings.json
SYSTEM_PROMPT_EXTRA=
