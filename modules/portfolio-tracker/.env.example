# Portfolio Tracker — Environment Variables
# See .env for live values.

# --- Required ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ACTUAL_BUDGET_URL=http://actual-api:3000
ACTUAL_BUDGET_PASSWORD=your-password
ACTUAL_BUDGET_FILE=Your Budget Name
MYR_BUDGET_FILE=Your MYR Budget Name

# --- Telegram ---
# Notifications go through OpenClaw gateway webhook (not direct Telegram)
# Set OPENCLAW_GATEWAY_URL if different from default

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_JSON=/app/config/google-service-account.json
GOOGLE_SHEET_ID=your-google-sheet-id
TAXONOMY_NAMES=Regions (Liquid)
TAXONOMY_SHEET_MAPPING=America:G2,Developed ex-US:G3,Emerging:G4,Crypto:G5,Investable Cash:B4

# --- Portfolio Performance ---
PP_XML_PATH=/data/portfolio.xml
PP_PASSWORD=your-pp-password
PP_JAR_PATH=/app/pp-cli.jar

# --- Actual Budget -> PP Balance Sync ---
AB_EMERGENCY_SGD_CATEGORY=Emergency
AB_EMERGENCY_MYR_CATEGORY=Emergency
AB_WARCHEST_CATEGORY=General Investment
PP_EMERGENCY_SGD_ACCOUNT=your-account-uuid
PP_EMERGENCY_MYR_ACCOUNT=your-account-uuid
PP_WARCHEST_SGD_ACCOUNT=your-account-uuid

# --- IMAP Email ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=your-email
IMAP_PASSWORD=your-password
IMAP_FOLDER=Trades

# --- Cron ---
PP_SYNC_ALL_CRON=0 3 * * *

# --- Notification SMTP ---
NOTIFICATION_SMTP_HOST=smtp.example.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_EMAIL=your-email

# --- Optional ---
LOG_LEVEL=INFO
BALANCE_SYNC_MODEL=deepseek-v4-pro
DEDUP_DB_PATH=data/dedup.db
MAPPINGS_PATH=data/mappings.json
ACTUAL_BUDGET_SERVER_URL=https://your-server.fly.dev
