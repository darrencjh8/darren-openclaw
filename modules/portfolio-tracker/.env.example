# =============================================================================
# Portfolio Tracker + Actual API — Shared Environment Variables
# =============================================================================
# This .env file is shared by three containers (see docker-compose.yml):
#   - actual-api        (env_file)
#   - portfolio-tracker (env_file)
#   - image-gen         (env_file)
#
# Copy this file to .env and fill in the values.
# All REQUIRED vars must be set; OPTIONAL vars have sensible defaults shown.

# ===========================================================================
# SECTION 1 — Actual Budget API (used by actual-api + portfolio-tracker)
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# Actual Budget server URL. Both ACTUAL_BUDGET_SERVER_URL and ACTUAL_BUDGET_URL
# are accepted; if both are set, ACTUAL_BUDGET_SERVER_URL takes precedence.
ACTUAL_BUDGET_URL=
# Actual Budget server password
ACTUAL_BUDGET_PASSWORD=
# Primary budget file name as it appears in Actual (e.g. "Darren SGD")
ACTUAL_PRIMARY_BUDGET_FILE=
# Secondary budget file name (e.g. "Darren MYR") — optional for actual-api,
# but used by expense-tracker for dual-currency support
ACTUAL_SECONDARY_BUDGET_FILE=

# ---------------------------------------------------------------------------
# OPTIONAL (actual-api defaults shown)
# ---------------------------------------------------------------------------
# PORT=3000
# DATA_DIR=/tmp/actual-data
# BUDGET_SWITCH_DELAY_MS=2000

# ===========================================================================
# SECTION 2 — Portfolio Tracker (core)
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# DeepSeek API key for LLM-powered classification & analysis
DEEPSEEK_API_KEY=
# Actual Budget file name as it appears in Actual (e.g. "Darren SGD")
ACTUAL_BUDGET_FILE=
# Path to Portfolio Performance XML file inside the container
PP_XML_PATH=
# Path to Portfolio Performance CLI jar inside the container
PP_JAR_PATH=
# OneDrive client ID for reading IBKR trade-confirmation PDFs
ONEDRIVE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Portfolio Performance — OPTIONAL (defaults shown)
# ---------------------------------------------------------------------------
# PP_PASSWORD=
# PP_SYNC_ALL_CRON=0 3 * * *
# BALANCE_SYNC_MODEL=

# ---------------------------------------------------------------------------
# Actual Budget category mappings — OPTIONAL (defaults shown)
# ---------------------------------------------------------------------------
# AB_EMERGENCY_SGD_CATEGORY=Emergency Fund SGD
# AB_EMERGENCY_MYR_CATEGORY=Emergency Fund MYR
# AB_WARCHEST_CATEGORY=General Investment Fund

# ---------------------------------------------------------------------------
# PP account UUIDs for balance sync — OPTIONAL
# ---------------------------------------------------------------------------
# PP_EMERGENCY_SGD_ACCOUNT=
# PP_EMERGENCY_MYR_ACCOUNT=
# PP_WARCHEST_SGD_ACCOUNT=

# ---------------------------------------------------------------------------
# Budget files — OPTIONAL
# ---------------------------------------------------------------------------
# MYR budget file name (for MYR-denominated portfolios)
# MYR_BUDGET_FILE=

# ---------------------------------------------------------------------------
# Google Sheets — OPTIONAL
# ---------------------------------------------------------------------------
# Path to Google service account JSON key file, or inline JSON string
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Google Sheet ID for portfolio data
# GOOGLE_SHEET_ID=

# ---------------------------------------------------------------------------
# Taxonomy — OPTIONAL (defaults shown)
# ---------------------------------------------------------------------------
# TAXONOMY_NAMES=Sector,Geography,Asset Class
# TAXONOMY_SHEET_MAPPING=

# ---------------------------------------------------------------------------
# IMAP for trade-confirmation emails — OPTIONAL (defaults shown)
# ---------------------------------------------------------------------------
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USERNAME=
# IMAP_PASSWORD=
# IMAP_FOLDER=Trades

# ---------------------------------------------------------------------------
# Notifications — OPTIONAL (defaults shown)
# ---------------------------------------------------------------------------
# OPENCLAW_GATEWAY_URL=http://openclaw:18800
# NOTIFICATION_SMTP_HOST=smtp.example.com
# NOTIFICATION_SMTP_PORT=587
# NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# OneDrive — OPTIONAL (defaults shown)
# ---------------------------------------------------------------------------
# ONEDRIVE_REFRESH_TOKEN_PATH=/app/config/onedrive_refresh_token
# ONEDRIVE_DATA_DIR=/data/onedrive

# ---------------------------------------------------------------------------
# Data Paths — OPTIONAL (defaults shown, relative to /app inside container)
# ---------------------------------------------------------------------------
# DEDUP_DB_PATH=data/dedup.db
# MAPPINGS_PATH=data/mappings.json

# ---------------------------------------------------------------------------
# Logging & Personalization — OPTIONAL (defaults shown)
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# USER_NAME=there
# SYSTEM_PROMPT_EXTRA=
