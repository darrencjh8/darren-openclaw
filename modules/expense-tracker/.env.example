# ===========================================
# OpenClaw Expense Tracker — Environment Variables
# Copy this file to .env and fill in your values.
# ===========================================
#
# IMPORTANT: OpenClaw only needs access to the BURNER INBOX.
#            It NEVER reads your main email. No main email password required.
#
# HOW NOTIFICATIONS WORK:
#   If OpenClaw can't parse an email → sends Telegram message to you
#   via the Telegram Bot API using the bot token configured here.

# --- LLM ---
# DeepSeek API key (get from https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# --- Actual Budget ---
# Actual Budget server URL
ACTUAL_BUDGET_URL=https://your-server.fly.dev
# Server password (set during Actual Budget server setup)
ACTUAL_BUDGET_PASSWORD=your-server-password
# Budget file name (as shown in Actual Budget)
ACTUAL_BUDGET_FILE=Your Budget Name
# Encryption password (same as server password for default config)
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=your-server-password
# Optional: encryption password if the budget file is encrypted
# ACTUAL_BUDGET_ENCRYPTION_PASSWORD=

# --- Burner Inbox (IMAP - Zoho) ---
# This is a SEPARATE email account that receives bank alerts.
# It is NOT your main email. Create a free Zoho Mail account for this.
# IMAP host
IMAP_HOST=imap.zoho.com
# IMAP port (993 = SSL)
IMAP_PORT=993
# Burner inbox email address (the one you created just for this)
IMAP_USERNAME=your-burner-inbox@zohomail.com
# App-specific password for the burner account
# Generate at: Zoho Mail → Settings → Mail Accounts → IMAP Access
IMAP_PASSWORD=your-burner-app-password

# --- Notifications (Telegram) ---
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh
# Your Telegram user ID (from @userinfobot)
TELEGRAM_CHAT_ID=488065038

# --- Dedup Journal ---
# Path to SQLite dedup database (default: data/dedup.db)
# DEDUP_DB_PATH=data/dedup.db

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# --- User ---
# Your name — the agent will address you by name in Telegram messages
USER_NAME=your-name
# Append extra instructions to the agent's system prompt.
# Use this to customize personality or add special rules.
# Example: "Be warm and friendly. Always use emojis."
# SYSTEM_PROMPT_EXTRA=

# --- Multi-budget (optional) ---
# MYR budget file name in Actual Budget (required for RM/MYR transactions)
# MYR_BUDGET_FILE=your-myr-budget-name

# --- Internal ---
# Actual API URL (default: http://localhost:3000 for local dev, http://actual-api:3000 in Docker)
# ACTUAL_API_URL=http://localhost:3000