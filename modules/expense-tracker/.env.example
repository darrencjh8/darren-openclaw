# ===========================================
# OpenClaw Expense Tracker — Environment Variables
# Copy this file to .env and fill in your values.
# ===========================================
#
# IMPORTANT: OpenClaw only needs access to the BURNER INBOX.
#            It NEVER reads your main email. No main email password required.
#
# HOW EMAIL FLOWS:
#   Bank/Payment alerts → forwarded to BURNER INBOX → OpenClaw reads via IMAP
#   If OpenClaw can't parse an email → sends notification FROM burner TO your main email via SMTP
#
#   All credentials below are for the BURNER ACCOUNT only.
#   NOTIFICATION_EMAIL is just a recipient address (no password needed to receive).

# --- LLM ---
# DeepSeek API key (get from https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# --- Actual Budget ---
# Actual Budget server URL
ACTUAL_BUDGET_URL=http://actual-budget.internal:5006
# Server password (set during Actual Budget server setup)
ACTUAL_BUDGET_PASSWORD=your-server-password
# Budget file name (e.g. "Darren SGD") or file UUID
ACTUAL_BUDGET_FILE=my-budget
# Optional: encryption password if the budget file is encrypted
# ACTUAL_BUDGET_ENCRYPTION_PASSWORD=

# --- Burner Inbox (IMAP) ---
# This is a SEPARATE email account that receives bank alerts.
# It is NOT your main email. Create a free Zoho Mail account for this.
# IMAP host
IMAP_HOST=imap.zoho.com
# IMAP port (993 = SSL)
IMAP_PORT=993
# Burner inbox email address (the one you created just for this)
IMAP_USERNAME=your-burner-inbox@zohomail.com
# App-specific password for the burner account
# Generate at: Zoho Mail → Settings → Mail Accounts → IMAP Access
IMAP_PASSWORD=your-burner-app-password

# --- Notifications (SMTP) ---
# OpenClaw sends notifications FROM the burner account TO your main email.
# SMTP host for the burner account
NOTIFICATION_SMTP_HOST=smtp.zoho.com
# SMTP port (587 = STARTTLS)
NOTIFICATION_SMTP_PORT=587
# Your MAIN email address — where you want to receive alerts
# This is just a recipient. No password needed for receiving!
NOTIFICATION_EMAIL=your-main-email@example.com
# SMTP password for the burner account (usually same as IMAP_PASSWORD above)
# If not set, defaults to IMAP_PASSWORD.
# NOTIFICATION_EMAIL_PASSWORD=

# --- Dedup Journal ---
# Path to SQLite dedup database (default: data/dedup.db)
# DEDUP_DB_PATH=data/dedup.db

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# --- Gateway ---
# Gateway health check URL (internal Docker network)
# GATEWAY_URL=http://gateway:18789