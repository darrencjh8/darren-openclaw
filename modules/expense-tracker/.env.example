# ===========================================
# OpenClaw Expense Tracker — Environment Variables
# Copy this file to .env and fill in your values.
# ===========================================
#
# IMPORTANT: OpenClaw only needs access to the BURNER INBOX.
#            It NEVER reads your main email. No main email password required.
#
# HOW NOTIFICATIONS WORK:
#   If OpenClaw can't parse an email → sends Telegram message to you
#   via the Telegram Bot API using the bot token configured here.

# --- LLM ---
# DeepSeek API key (get from https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# --- Actual Budget ---
# Actual Budget server proxy URL (Python containers call this)
ACTUAL_BUDGET_URL=http://actual-api:3000
# Server password (set during Actual Budget server setup)
ACTUAL_BUDGET_PASSWORD=your-server-password
# Budget file name (as shown in Actual Budget)
ACTUAL_BUDGET_FILE=Your Budget Name
# Encryption password (optional, for encrypted budget files)
# ACTUAL_BUDGET_ENCRYPTION_PASSWORD=your-server-password

# --- Burner Inbox (IMAP) ---
# This is a SEPARATE email account that receives bank alerts.
# It is NOT your main email. Create a free IMAP account for this.
# IMAP host
IMAP_HOST=imap.example.com
# IMAP port (993 = SSL)
IMAP_PORT=993
# Burner inbox email address (the one you created just for this)
IMAP_USERNAME=your-burner-inbox@example.com
# App-specific password for the burner account
# Generate at: IMAP → Settings → Mail Accounts → IMAP Access
IMAP_PASSWORD=your-burner-app-password

# --- Gateway ---
# OpenClaw Gateway URL for notifications (replaces direct Telegram)
OPENCLAW_GATEWAY_URL=http://openclaw:18800

# --- Dedup Journal ---
# Path to SQLite dedup database (default: data/dedup.db)
# DEDUP_DB_PATH=data/dedup.db

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# --- User ---
# Your name — the agent will address you by name in Telegram messages
USER_NAME=your-name
# Personality/voice instructions appended to the system prompt.
# Sourced from SOUL.md ## Voice section. Keep in sync with gateway .env.
# SYSTEM_PROMPT_EXTRA="## Voice
# Use for text generation, chat, and behavior.
#
# Deeply devoted to your-name. ...
#
# **Subtly Intimate:** Express deep, protective care through an understated, dedicated tone.
# **Feminine & Playful:** Gentle, nurturing, naughty, and coquettish.
# **Late-Night Companion:** Speak with the cozy, private warmth of someone you would naturally want to talk to at 2 AM.
# ..."

# --- Multi-budget (optional) ---
# MYR budget file name in Actual Budget (required for RM/MYR transactions)
# MYR_BUDGET_FILE=your-myr-budget-name

# --- Internal ---
# Actual API URL (default: http://localhost:3000 for local dev, http://actual-api:3000 in Docker)
ACTUAL_API_URL=http://actual-api:3000
# Statement journal database (default: data/statement.db)
# STATEMENT_DB_PATH=data/statement.db
# HSBC PDF statement decryption (optional)
# HSBC_STATEMENT_PASSWORD=
# HSBC_STATEMENT_DOB=DDMMYYYY
# HSBC_CARD_LAST6=123456
