# Kokoro TTS Configuration
#
# The docker-compose.yml uses 127.0.0.1:8880 by default.
# To expose on LAN (e.g. for Windows Companion), change to "8880:8880" in docker-compose.yml.
#
# No env vars required — the model auto-downloads on first start.
# Model files are persisted in a Docker volume (kokoro_models).
#
# Available voices (82M ONNX model):
#   American English:  af_heart, af_bella, af_nicole, af_aoede, af_kore, af_sarah
#   American English:  am_adam, am_michael
#   British English:   bf_emma, bf_isabella, bm_george, bm_lewis
#
# API:
#   POST /v1/audio/speech
#   Body: {"input": "Hello world", "voice": "af_heart"}
#   Returns: audio/wav
#
#   GET /health  → 200 OK
